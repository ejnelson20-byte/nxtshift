# ---------------------------------------------------------------------------
# Client-safe values (embedded in the app binary; NOT secrets).
# Use the Supabase *publishable* key (sb_publishable_...). Projects still on
# legacy keys may set EXPO_PUBLIC_SUPABASE_ANON_KEY instead.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Server-side secrets — NEVER prefix with EXPO_PUBLIC_ and never commit.
# Set with: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by the Supabase platform.)
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# >= 32 random characters; also stored in Vault as nxtshift_cron_secret
ESCALATION_CRON_SECRET=
# Anthropic API key for parse-shift-schedule (feature returns 503 when unset)
LLM_API_KEY=
# Optional model override (default: claude-opus-5-5)
LLM_MODEL=
# Optional: Expo push "enhanced security" access token
EXPO_ACCESS_TOKEN=
# Random value used to hash client IPs for rate limiting
RATE_LIMIT_SALT=
